{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tvanfossen/homeschool-assistant/proposal-schema.json",
  "title": "Proposal Frontmatter Schema",
  "description": "YAML frontmatter schema for all proposal markdown files",
  "type": "object",
  "required": [
    "proposal_id",
    "title",
    "created",
    "updated",
    "status",
    "priority",
    "complexity",
    "category",
    "estimated_hours",
    "progress_percent"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable title"
    },
    "github_issue": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "GitHub issue number"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date (ISO 8601: YYYY-MM-DD)"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date (ISO 8601: YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": ["TODO", "ACTIVE_WORK", "STAGED", "COMPLETED", "STALLED"],
      "description": "Current proposal status"
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "Priority level"
    },
    "complexity": {
      "type": "string",
      "enum": ["trivial", "simple", "medium", "complex", "epic"],
      "description": "Effort complexity"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "technical-debt",
          "feature",
          "bug",
          "infrastructure",
          "testing",
          "documentation"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Category tags"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Free-form tags"
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated effort in hours"
    },
    "actual_hours": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Actual tracked hours"
    },
    "progress_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Completion percentage"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": [],
      "description": "List of proposal_ids this depends on"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": [],
      "description": "List of proposal_ids this blocks"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,40}$"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Git commit SHAs"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Git branches"
    },
    "pull_requests": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true,
      "default": [],
      "description": "GitHub PR numbers"
    },
    "agent_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "agent", "note", "action"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 datetime"
          },
          "agent": {
            "type": "string",
            "description": "Agent name (gh_active_work, gh_verify, etc.)"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "Work note/decision/blocker"
          },
          "action": {
            "type": "string",
            "enum": [
              "started",
              "progressed",
              "blocked",
              "completed",
              "stalled"
            ],
            "description": "Action type"
          }
        }
      },
      "default": [],
      "description": "Agent activity log"
    },
    "stall_reason": {
      "type": ["string", "null"],
      "description": "Why stalled (if status=STALLED)"
    },
    "unblock_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "What's needed to unblock"
    },
    "completion_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date moved to COMPLETED (ISO 8601: YYYY-MM-DD)"
    },
    "verification_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "skipped"],
      "default": "pending",
      "description": "Verification/review status"
    }
  },
  "additionalProperties": false
}
